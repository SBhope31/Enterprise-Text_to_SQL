# ---- LLM Provider (OpenAI-compatible) ----
# Default: Google Gemini's OpenAI-compatible endpoint (free tier).
# Get a key at https://aistudio.google.com/apikey
OPENAI_API_KEY=replace-with-your-gemini-key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_CHAT_MODEL=gemini-2.5-flash-lite
OPENAI_EMBED_MODEL=gemini-embedding-001
# To use OpenAI instead, unset OPENAI_BASE_URL and use:
#   OPENAI_CHAT_MODEL=gpt-4o-mini
#   OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=textsql

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=schema_context

# ---- Redis (optional cache) ----
REDIS_URL=redis://localhost:6379/0

# ---- App ----
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SQL_EXEC_TIMEOUT_SECONDS=10
SQL_MAX_ROWS=500
RETRIEVAL_TOP_K=5
